---
import { Image } from "astro:assets";
import "../styles/global.css";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import PostHog from "../components/PostHog.astro";
import cactusInBloom from "../assets/cactus-in-bloom.jpg";
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/cactus-seal.svg" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="color-scheme" content="only light" />
        <meta name="darkreader-lock" />
        <meta name="generator" content={Astro.generator} />
        <title>Mad Cactus — Turn Your Business AI-Native</title>
        <meta
            name="description"
            content="We build the intelligence layer, custom agents, and workflows that make AI actually work for your business."
        />
        <PostHog />
    </head>
    <body>
        <Header />

        {/* ════════ HERO ════════ */}
        <section class="hero">
            <div class="hero-inner">
                <div class="hero-text">
                    <h1 class="hero-headline">
                        Turn Your<br />Business<br />
                        <em>AI-Native.</em>
                    </h1>
                    <p class="hero-body">
                        We build the intelligence layer, custom agents, and
                        workflows that make AI actually work for your business.
                        Letting your team of five operate like a team of
                        twenty-five.
                    </p>
                    <a
                        href="/scorecard"
                        class="cta-bracketed cta-hero" data-ph-event="cta_scorecard">&#123; TAKE THE AI SCORECARD &#125;</a
                    >
                </div>
                <div class="hero-plate">
                    <Image
                        src={cactusInBloom}
                        alt="Cactus in bloom"
                        widths={[480, 800, 1200]}
                        sizes="50vw"
                        loading="eager"
                    />
                </div>
            </div>
        </section>

        {/* ════════ SERVICES ════════ */}
        <section id="services">
            <div class="section-header">
                <h2 class="section-title">Our Method</h2>
                <hr class="section-rule" />
            </div>
            <div class="services-grid">
                <div class="service-col">
                    <div class="service-num">01</div>
                    <h3>Business Audit</h3>
                    <p>
                        Our agent books meetings with you and every one of your
                        employees to learn about each workflow, the
                        dependencies, and how everyone does their job. This
                        gives insights into how your business generates value
                        and reveals what workflows can be augmented by AI.
                    </p>
                </div>
                <div class="service-col">
                    <div class="service-num">02</div>
                    <h3>Intelligence Layer</h3>
                    <p>
                        Your company's brain. Unify your data, docs, and
                        institutional knowledge into a single intelligence layer
                        that agents can reason over in real time — across Slack,
                        Google Drive, Box, Teams, and every meeting, customer
                        interaction, and sale.
                    </p>
                </div>
                <div class="service-col">
                    <div class="service-num">03</div>
                    <h3>Agent Development</h3>
                    <p>
                        We build custom agents that automate and augment your
                        workflows, allowing your team to hand off entire tasks
                        to AI and spend more time on what matters most. Allowing
                        your business to grow faster than ever before.
                    </p>
                </div>
            </div>
        </section>

        {/* ════════ DARK BAND — PHILOSOPHY ════════ */}
        <div class="dark-band">
            <div class="dark-band-inner">
                <h2 class="dark-band-headline">
                    If you can't hand off tasks<br />
                    to agents, <em>you don't pay.</em>
                </h2>
                <p class="dark-band-body">
                    We don't sell hours or piecemeal tools. We embed with your
                    team, audit your operations, build your AI intelligence
                    layer, deploy custom agents, and train your people to run
                    them. The work speaks for itself.
                </p>
            </div>
        </div>

        {/* ════════ NEWSLETTER BAND ════════ */}
        <section id="newsletter-band">
            <div class="newsletter-band-inner">
                <div class="newsletter-band-text">
                    <h3 class="newsletter-band-heading">
                        AI teardowns <em>from real clients.</em>
                    </h3>
                    <p class="newsletter-band-body">
                        Weekly breakdowns of real AI deployments. What we
                        built, what it cost, and the blueprint to do the same.
                    </p>
                </div>
                <form class="newsletter-band-form" id="newsletterBandForm">
                    <input
                        type="email"
                        name="email"
                        placeholder="your@email.com"
                        required
                        autocomplete="email"
                    />
                    <button type="submit" class="cta-bracketed" data-ph-event="newsletter_signup_home">&#123; SUBSCRIBE &#125;</button>
                </form>
            </div>
        </section>

        {/* ════════ CASE STUDY ════════ */}
        <section id="case-studies">
            <div class="section-header">
                <h2 class="section-title">Proven in Production</h2>
                <hr class="section-rule" />
            </div>
            <a href="/iu" class="case-study-card" data-ph-event="case_study_click">
                <div class="case-study-visual">
                    <span class="case-study-institution">INDIANA<br /><em>UNIVERSITY</em></span>
                    <span class="case-study-sector">Data Engineering</span>
                </div>
                <div class="case-study-content">
                    <h3 class="case-study-title">
                        Autonomous data engineering agent that
                        transformed IU's ticket resolution pipeline.
                    </h3>
                    <p class="case-study-desc">
                        A custom AI agent performing intelligent first-pass
                        analysis on incoming data engineering tickets.
                        Triaging issues, identifying root causes, and routing
                        with context.
                    </p>
                    <div class="case-study-stats">
                        <div class="stat">
                            <strong>45%</strong>
                            <span>Productivity Increase</span>
                        </div>
                        <div class="stat">
                            <strong>MTTR</strong>
                            <span>Significantly Reduced</span>
                        </div>
                        <div class="stat">
                            <strong>Q2-Q3</strong>
                            <span>Measured Impact</span>
                        </div>
                    </div>
                    <span class="case-study-link cta-bracketed">&#123; READ FULL CASE STUDY &#125;</span>
                </div>
            </a>
        </section>

        {/* ════════ SCORECARD CTA ════════ */}
        <section class="lead-section">
            <div class="lead-inner">
                <div class="lead-left">
                    <h3 class="lead-heading">
                        How much is manual work<br />
                        <em>costing your firm?</em>
                    </h3>
                </div>
                <div class="lead-right">
                    <p>
                        Take our free AI Readiness Scorecard. In five minutes,
                        you'll see exactly where your team wastes the most time,
                        the estimated annual cost, and where AI can have the
                        biggest impact.
                    </p>
                    <a href="/scorecard" class="cta-bracketed" data-ph-event="cta_scorecard">&#123; TAKE THE AI SCORECARD &#125;</a
                    >
                </div>
            </div>
        </section>

        <Footer />
    </body>
</html>

<style is:global>
    /* ═══ Hero ═══ */
    /* ponytail: on this page the top bar overlays the hero so the painting bleeds top + right; scoped here so /iu and /scorecard keep flow layout. Upgrade path: move to a shared page wrapper if more pages want it. */
    .top-bar {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        z-index: 30;
        background: transparent;
    }
    .top-bar-signin {
        background: rgba(0, 0, 0, 0.6);
        color: #fff;
        border-color: #fff;
    }
    .top-bar-signin:hover {
        background: #fff;
        color: var(--color-letterpress-black);
    }
    .hero {
        padding: 0;
        min-height: 100vh;
    }
    .hero-inner {
        display: flex;
        align-items: stretch;
        min-height: 100vh;
        gap: var(--spacing-48);
    }
    .hero-text {
        align-self: center;
        margin-left: max(
            var(--spacing-64),
            calc((100vw - var(--page-max-width)) / 2 + var(--spacing-64))
        );
        max-width: 520px;
        flex-shrink: 0;
        padding-right: var(--spacing-32);
    }
    .hero-headline {
        font-family: var(--font-serif);
        font-weight: 400;
        font-size: var(--text-heading);
        line-height: var(--leading-display);
        color: var(--color-letterpress-black);
        margin-bottom: var(--spacing-24);
    }
    .hero-headline em {
        font-style: italic;
        font-weight: 400;
    }
    .hero-body {
        font-family: var(--font-serif);
        font-size: var(--text-body);
        line-height: var(--leading-body);
        color: var(--color-letterpress-black);
        max-width: 360px;
        margin-bottom: var(--spacing-32);
    }
    .hero-plate {
        flex: 1;
        min-width: 0;
        min-height: 0;
        overflow: hidden;
    }
    .hero-plate img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    /* ponytail: scroll-tied parallax, progressive enhancement. No JS. Overscan height covers translateY gaps; @support guard avoids broken layout in older browsers. */
    @supports (animation-timeline: scroll()) {
        .hero-plate img {
            height: 130%;
            animation: hero-parallax linear both;
            animation-timeline: scroll(root);
        }
        @keyframes hero-parallax {
            from {
                transform: translateY(-15%);
            }
            to {
                transform: translateY(0);
            }
        }
    }

    /* ═══ Section Header ═══ */
    .section-header {
        max-width: var(--page-max-width);
        margin: 0 auto var(--spacing-48);
        padding: 0 var(--spacing-64);
    }
    #services,
    #case-studies,
    .lead-section {
        padding: var(--spacing-80) 0;
    }

    /* ═══ Services Grid ═══ */
    .services-grid {
        max-width: var(--page-max-width);
        margin: 0 auto;
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        background: var(--color-paper);
        border-top: 1px solid var(--color-letterpress-black);
        border-bottom: 1px solid var(--color-letterpress-black);
    }
    .service-col {
        padding: var(--card-padding);
        border-right: 1px solid var(--color-letterpress-black);
    }
    .service-col:last-child {
        border-right: none;
    }
    .service-num {
        font-family: var(--font-sans);
        font-size: var(--text-caption);
        color: var(--color-silver-wash);
        margin-bottom: var(--spacing-16);
    }
    .service-col h3 {
        font-family: var(--font-serif);
        font-weight: 400;
        font-size: var(--text-subheading);
        color: var(--color-letterpress-black);
        margin-bottom: var(--spacing-16);
    }
    .service-col p {
        font-family: var(--font-serif);
        font-size: var(--text-body-sm);
        line-height: var(--leading-body);
        color: var(--color-letterpress-black);
    }

    /* ═══ Dark Band ═══ */
    .dark-band {
        background: var(--color-gallery-ink);
        padding: var(--spacing-128) var(--spacing-64);
    }
    .dark-band-inner {
        max-width: 800px;
        margin: 0 auto;
        text-align: center;
    }
    .dark-band-label {
        font-family: var(--font-sans);
        font-size: var(--text-caption);
        color: var(--color-silver-wash);
        margin-bottom: var(--spacing-24);
    }
    .dark-band-headline {
        font-family: var(--font-serif);
        font-weight: 400;
        font-size: var(--text-heading);
        line-height: var(--leading-display);
        color: var(--color-paper);
        margin-bottom: var(--spacing-32);
    }
    .dark-band-headline em {
        font-style: italic;
        color: var(--color-burnished-gold);
    }
    .dark-band-body {
        font-family: var(--font-serif);
        font-size: var(--text-body);
        line-height: var(--leading-body);
        color: var(--color-silver-wash);
        max-width: 520px;
        margin: 0 auto;
    }

    /* ═══ Newsletter Band ═══ */
    #newsletter-band {
        background: var(--color-paper);
        border-top: 1px solid var(--color-letterpress-black);
        border-bottom: 1px solid var(--color-letterpress-black);
    }
    .newsletter-band-inner {
        max-width: var(--page-max-width);
        margin: 0 auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--spacing-48);
        padding: var(--spacing-48) var(--spacing-64);
    }
    .newsletter-band-heading {
        font-family: var(--font-serif);
        font-weight: 400;
        font-size: var(--text-subheading);
        line-height: var(--leading-display);
        color: var(--color-letterpress-black);
        margin-bottom: var(--spacing-8);
    }
    .newsletter-band-heading em {
        font-style: italic;
    }
    .newsletter-band-body {
        font-family: var(--font-serif);
        font-size: var(--text-body-sm);
        line-height: var(--leading-body);
        color: var(--color-silver-wash);
        max-width: 380px;
    }
    .newsletter-band-form {
        display: flex;
        gap: var(--spacing-16);
        flex-shrink: 0;
    }
    .newsletter-band-form input {
        font-family: var(--font-serif);
        font-size: var(--text-body);
        padding: 12px 16px;
        border: 1px solid var(--color-letterpress-black);
        background: var(--color-vellum-white);
        color: var(--color-letterpress-black);
        outline: none;
        width: 220px;
    }
    .newsletter-band-form input:focus {
        border-color: var(--color-burnished-gold);
    }
    .newsletter-band-form button {
        cursor: pointer;
        background: none;
        border: none;
        padding: 12px 20px;
        white-space: nowrap;
    }

    /* ═══ Case Study ═══ */
    .case-study-card {
        display: block;
        max-width: var(--page-max-width);
        margin: 0 auto;
        padding: 0 var(--spacing-64);
    }
    .case-study-content {
        background: var(--color-paper);
        padding: var(--spacing-48) var(--card-padding);
        border-top: 1px solid var(--color-letterpress-black);
        border-bottom: 1px solid var(--color-letterpress-black);
    }
    .case-study-visual {
        background: var(--color-gallery-ink);
        padding: var(--spacing-48) var(--card-padding);
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        gap: var(--spacing-16);
        min-height: 200px;
        text-align: center;
    }
    .case-study-institution {
        font-family: var(--font-serif);
        font-weight: 400;
        font-size: var(--text-heading);
        line-height: var(--leading-display);
        color: var(--color-paper);
        letter-spacing: -1px;
    }
    .case-study-institution em {
        font-style: italic;
    }
    .case-study-sector {
        font-family: var(--font-sans);
        font-size: var(--text-caption);
        letter-spacing: 3px;
        text-transform: uppercase;
        color: var(--color-burnished-gold);
    }
    .case-study-title {
        font-family: var(--font-serif);
        font-weight: 400;
        font-size: var(--text-subheading);
        line-height: 1.3;
        color: var(--color-letterpress-black);
        margin-bottom: var(--spacing-16);
    }
    .case-study-desc {
        font-family: var(--font-serif);
        font-size: var(--text-body-sm);
        line-height: var(--leading-body);
        color: var(--color-letterpress-black);
        margin-bottom: var(--spacing-32);
    }
    .case-study-stats {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 0;
        padding-top: var(--spacing-32);
        border-top: 1px solid var(--color-letterpress-black);
    }
    .stat {
        padding: 0 var(--spacing-16);
        border-right: 1px solid var(--color-letterpress-black);
    }
    .stat:first-child {
        padding-left: 0;
    }
    .stat:last-child {
        border-right: none;
        padding-right: 0;
    }
    .stat strong {
        font-family: var(--font-sans);
        font-weight: 700;
        font-size: var(--text-subheading);
        letter-spacing: 1px;
        color: var(--color-letterpress-black);
        display: block;
        line-height: 1;
        margin-bottom: var(--spacing-8);
    }
    .stat span {
        font-family: var(--font-sans);
        font-size: var(--text-caption);
        color: var(--color-silver-wash);
        display: block;
    }
    .case-study-link {
        font-family: var(--font-sans);
        font-size: var(--text-body-sm);
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: var(--color-letterpress-black);
        margin-top: var(--spacing-32);
        display: inline-block;
    }
    .case-study-link:hover {
        color: var(--color-burnished-gold);
    }

    /* ═══ Lead Magnet ═══ */
    .lead-section {
        padding-bottom: var(--spacing-128);
    }
    .lead-inner {
        max-width: var(--page-max-width);
        margin: 0 auto;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: var(--spacing-48);
        padding: 0 var(--spacing-64);
    }
    .lead-heading {
        font-family: var(--font-serif);
        font-weight: 400;
        font-size: var(--text-heading);
        line-height: var(--leading-display);
        color: var(--color-letterpress-black);
    }
    .lead-heading em {
        font-style: italic;
    }
    .lead-right p {
        font-family: var(--font-serif);
        font-size: var(--text-body);
        line-height: var(--leading-body);
        color: var(--color-letterpress-black);
        margin-bottom: var(--spacing-32);
        max-width: 400px;
    }

    /* ═══ Responsive ═══ */
    @media (max-width: 900px) {
        .top-bar {
            padding: var(--spacing-24) var(--spacing-24);
        }
        .top-bar {
            position: static;
        }
        .hero {
            padding: var(--spacing-32) var(--spacing-24) var(--spacing-80);
            min-height: auto;
        }
        .hero-inner {
            flex-direction: column;
            align-items: stretch;
            min-height: auto;
            gap: var(--spacing-32);
        }
        .hero-text {
            margin-left: 0;
            max-width: none;
            padding-right: 0;
            align-self: auto;
        }
        .hero-plate {
            flex: none;
            height: 340px;
            min-height: 340px;
        }
        .hero-plate img {
            height: 100%;
            animation: none;
        }
        .section-header {
            padding: 0 var(--spacing-24);
        }
        .services-grid {
            grid-template-columns: 1fr;
        }
        .service-col {
            border-right: none;
            border-bottom: 1px solid var(--color-letterpress-black);
        }
        .service-col:last-child {
            border-bottom: none;
        }
        .dark-band {
            padding: var(--spacing-80) var(--spacing-24);
        }
        .case-study-card {
            padding: 0 var(--spacing-24);
        }
        .case-study-stats {
            grid-template-columns: 1fr;
            gap: var(--spacing-24);
        }
        .stat {
            border-right: none;
            border-bottom: 1px solid var(--color-letterpress-black);
            padding: 0 0 var(--spacing-16) 0;
        }
        .stat:last-child {
            border-bottom: none;
            padding-bottom: 0;
        }
        .newsletter-band-inner {
            flex-direction: column;
            align-items: flex-start;
        }
        .newsletter-band-form {
            width: 100%;
        }
        .newsletter-band-form input {
            width: 100%;
            flex: 1;
        }
        .lead-inner {
            grid-template-columns: 1fr;
            padding: 0 var(--spacing-24);
        }
        #services,
        #case-studies,
        .lead-section {
            padding: var(--spacing-48) 0;
        }
    }
</style>

<script>
    // Newsletter band signup
    const bandForm = document.getElementById('newsletterBandForm');
    if (bandForm) {
        bandForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            const email = bandForm.email.value.trim();
            const btn = bandForm.querySelector('button');
            const API_URL = window.location.hostname === 'localhost'
                ? 'http://localhost:3000/api/newsletter'
                : 'https://app.madcactus.org/api/newsletter';
            btn.textContent = 'Subscribing...';
            btn.disabled = true;
            try {
                const res = await fetch(API_URL, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ email }),
                });
                const data = await res.json();
                if (data.ok) {
                    bandForm.innerHTML = '<p style="font-family: var(--font-serif); font-style: italic; font-size: var(--text-body-sm);">You\'re in. Check your inbox.</p>';
                } else {
                    throw new Error(data.error || 'Failed');
                }
            } catch (err) {
                btn.textContent = '{ SUBSCRIBE }';
                btn.disabled = false;
            }
        });
    }
</script>
