{
	"name": "dashboard",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "tsc --noEmit && vite build",
		"typecheck": "tsc --noEmit",
		"prepare": "command -v git >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
		"start": "bun .output/server/index.mjs",
		"preview": "vite preview",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:push": "drizzle-kit push",
		"db:studio": "drizzle-kit studio"
	},
	"dependencies": {
		"@kobalte/core": "^0.13.12",
		"@solidjs/meta": "^0.29.4",
		"@solidjs/router": "^0.16.2",
		"@solidjs/start": "^2.0.0-beta.0",
		"@supabase/ssr": "^0.12.3",
		"@supabase/supabase-js": "^2.110.7",
		"autoprefixer": "^10.5.4",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cva": "1.0.0-beta.8",
		"drizzle-orm": "^0.45.2",
		"nitro": "^3.0.260610-beta",
		"pdfkit": "^0.19.1",
		"postcss": "^8.5.19",
		"postgres": "^3.4.9",
		"resend": "^6.18.0",
		"solid-js": "^1.9.5",
		"tailwind-merge": "^3.6.0",
		"tailwindcss": "3",
		"tailwindcss-animate": "^1.0.7",
		"vite": "^8.0.0"
	},
	"engines": {
		"node": ">=24"
	},
	"devDependencies": {
		"@types/bun": "^1.4.0",
		"@types/node": "^26.1.1",
		"@types/pdfkit": "^0.17.6",
		"drizzle-kit": "^0.31.10",
		"typescript": "^7.0.2"
	}
}
