SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key
# Public origin of this app. Used to build Supabase invite/reset redirect URLs
# (must be allowlisted in Supabase → Authentication → URL Configuration).
PUBLIC_SITE_URL=https://portal.madcactus.org
# Direct Postgres connection for Drizzle ORM.
# Supabase Dashboard → Settings → Database → Connection string → Session pooler.
# Format: postgresql://postgres.PROJECT:[PASSWORD]@aws-0-REGION.pooler.supabase.com:5432/postgres
DATABASE_URL=your-postgres-connection-string
SESSION_SECRET=change-me-in-production
OPENROUTER_API_KEY=your-openrouter-key-here
RESEND_API_KEY=your-resend-api-key-here

# Create a project at https://posthog.com — Project Settings
POSTHOG_KEY=your-posthog-project-key
POSTHOG_HOST=https://us.i.posthog.com
# Personal API key (different from project key) for reading analytics via the REST API.
# Create one at PostHog → Settings → Personal API keys. Leave blank to hide the Page Views tile.
POSTHOG_PERSONAL_KEY=

# Linear personal API key for the Open Issues tile.
# Create one at https://linear.app/settings/account/api-keys. Leave blank to hide the tile.
LINEAR_API_KEY=

# Dev test credentials (set real values in your local .env)
DEV_ADMIN_EMAIL=admin@madcactus.org
DEV_ADMIN_PASSWORD=your-dev-admin-password
DEV_CLIENT_EMAIL=client@cdl.example
DEV_CLIENT_PASSWORD=your-dev-client-password

# Gmail OAuth — Google Cloud Console → Credentials → OAuth client ID (Web application)
# Authorized redirect URIs (add both):
#   https://app.madcactus.org/api/email/oauth
#   http://localhost:3000/api/email/oauth
# Scopes requested: gmail.readonly, gmail.send, gmail.modify
GMAIL_CLIENT_ID=your-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-client-secret

# ── Company brain ──
# Model for memory generation + judge (OpenRouter model id).
BRAIN_MODEL=anthropic/claude-sonnet-4.5
# shared secret for POST /api/brain/cycle (scheduler auth — Supabase cron, GH Action, Fly machine)
# Slack brain source. SLACK_TOKEN (preferred) accepts either:
#   xoxp user token  → sees EVERYTHING you can see (public + private + DMs); user scopes:
#     users:read users:read.email channels:read channels:history groups:read groups:history im:read im:history mpim:read mpim:history
#   xoxb bot token   → only public channels the bot is /invite-d to; bot scopes:
#     users:read users:read.email channels:read channels:history
SLACK_TOKEN=
# SLACK_BOT_TOKEN=  (legacy alias for an xoxb token)
# Embeddings ride the same OpenRouter key as chat (default: openai/text-embedding-3-large).
# Override only if you want a different embeddings provider:
# EMBEDDINGS_API_KEY=
# EMBEDDINGS_BASE_URL=https://api.openai.com/v1
# EMBEDDINGS_MODEL=text-embedding-3-large
CRON_SECRET=
# Hosted gbrain (optional): `gbrain serve --http` URL + `gbrain auth create` token.
# When set, search_brain proxies gbrain_query; when unset the tool reports "not configured".
