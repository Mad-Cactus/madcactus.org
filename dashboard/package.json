{
  "name": "dashboard",
  "type": "module",
  "scripts": {
    "dev": "bun --bun vite dev --port 3000",
    "build": "tsc --noEmit && bun --bun vite build && bun run scripts/copy-loro-wasm.ts && bun run scripts/check-client-bundle.ts",
    "typecheck": "tsc --noEmit",
    "prepare": "command -v git >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "start": "bun .output/server/index.mjs",
    "test": "DATABASE_URL=postgres://dummy@localhost:5/dummy bun test src/lib",
    "preview": "bun --bun vite preview",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bash scripts/db-guard.sh migrate",
    "db:push": "bash scripts/db-guard.sh push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@aspectrr/feedback-widget": "^0.1.4",
    "@kobalte/core": "^0.13.12",
    "@lexical/code": "0.45.0",
    "@lexical/headless": "0.45.0",
    "@lexical/history": "0.45.0",
    "@lexical/link": "0.45.0",
    "@lexical/list": "0.45.0",
    "@lexical/markdown": "0.45.0",
    "@lexical/rich-text": "0.45.0",
    "@lexical/table": "0.45.0",
    "@lexical/utils": "0.45.0",
    "@solidjs/meta": "^0.29.4",
    "@solidjs/router": "^0.16.2",
    "@solidjs/start": "^2.0.0-beta.0",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.7",
    "autoprefixer": "^10.5.4",
    "clsx": "^2.1.1",
    "cmdk-solid": "^1.2.0",
    "cva": "1.0.0-beta.8",
    "diff": "^9.0.0",
    "docx": "^9.7.1",
    "drizzle-orm": "^0.45.2",
    "lexical": "0.45.0",
    "loro-crdt": "1.13.7",
    "marked": "^18.0.11",
    "modern-screenshot": "^4.7.0",
    "nitro": "^3.0.260610-beta",
    "pdfkit": "^0.19.1",
    "postcss": "^8.5.19",
    "resend": "^6.18.0",
    "solid-js": "^1.9.5",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "3",
    "tailwindcss-animate": "^1.0.7",
    "vite": "^8.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@types/pdfkit": "^0.17.6",
    "drizzle-kit": "^0.31.10",
    "typescript": "^7.0.2",
    "postgres": "^3.4.9"
  }
}
